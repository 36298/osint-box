name: Build Android APK

on:
  push:
    branches: [main, master]
  pull_request:
  workflow_dispatch:

concurrency:
  group: build-apk-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Build release APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Flutter (stable)
        uses: subosito/flutter-action@v2
        with:
          channel: stable
          cache: true

      - name: Scaffold Android project
        run: flutter create . --org com.osintbox --project-name osint_box --platforms android

      - name: Configure manifest permissions & queries (INTERNET + Android 11+)
        run: |
          python3 - <<'PY'
          import pathlib
          p = pathlib.Path('android/app/src/main/AndroidManifest.xml')
          s = p.read_text()
          internet = '<uses-permission android:name="android.permission.INTERNET"/>'
          if 'android.permission.INTERNET' not in s:
              s = s.replace('<application', internet + '\n    <application', 1)
          queries = ('<queries>'
                     '<intent><action android:name="android.intent.action.VIEW"/>'
                     '<data android:scheme="http"/></intent>'
                     '<intent><action android:name="android.intent.action.VIEW"/>'
                     '<data android:scheme="https"/></intent>'
                     '<intent><action android:name="android.intent.action.SEND"/>'
                     '<data android:mimeType="text/plain"/></intent>'
                     '</queries>')
          if '<queries>' not in s:
              s = s.replace('<application', queries + '\n    <application', 1)
          p.write_text(s)
          print(s)
          PY

      - name: Install dependencies
        run: flutter pub get

      - name: Build release APK
        run: |
          flutter config --no-analytics
          flutter build apk --release

      - name: Verify APK artifact
        run: |
          set -euo pipefail
          test -f build/app/outputs/flutter-apk/app-release.apk
          ls -lh build/app/outputs/flutter-apk/
          sha256sum build/app/outputs/flutter-apk/app-release.apk

      - name: Upload release APK
        uses: actions/upload-artifact@v4
        with:
          name: OSINT-Box-release-APK
          path: build/app/outputs/flutter-apk/app-release.apk
          if-no-files-found: error
          retention-days: 30
